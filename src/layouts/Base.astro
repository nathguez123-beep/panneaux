---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  updated?: string;
  faq?: { q: string; a: string }[];
}

const { title, description, canonical, updated, faq } = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

const pages = [
  { href: '/', label: 'Accueil' },
  { href: '/reforme-photovoltaique-juin-2026/', label: 'Réforme de juin 2026' },
  { href: '/rentabilite-panneaux-solaires-2026/', label: 'Rentabilité 2026' },
  { href: '/aides-panneaux-solaires-2026/', label: 'Aides 2026' },
  { href: '/tva-5-5-panneaux-solaires/', label: 'TVA 5,5 %' },
  { href: '/tarif-rachat-edf-oa/', label: 'Tarif de rachat EDF OA' },
];

const legalPages = [
  { href: '/mentions-legales/', label: 'Mentions légales' },
  { href: '/politique-de-confidentialite/', label: 'Politique de confidentialité' },
];

const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalURL,
  inLanguage: 'fr-FR',
  ...(updated ? { dateModified: updated } : {}),
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalURL} />

    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <style>
      :root {
        --texte: #1a1a1a;
        --lien: #0b5c3f;
        --discret: #5a5a5a;
        --bordure: #e2e2e2;
        --encadre: #f4f8f6;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          'Helvetica Neue', Arial, sans-serif;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--texte);
        background: #fff;
      }

      header,
      main,
      footer {
        max-width: 70ch;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      header {
        padding-top: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--bordure);
      }

      main {
        padding-top: 2.5rem;
        padding-bottom: 3rem;
      }

      footer {
        padding-top: 1.5rem;
        padding-bottom: 3rem;
        border-top: 1px solid var(--bordure);
        color: var(--discret);
        font-size: 0.95rem;
      }

      nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
      }

      h1 {
        font-size: 1.9rem;
        line-height: 1.25;
        margin: 0 0 1.5rem;
      }

      h2 {
        font-size: 1.35rem;
        line-height: 1.3;
        margin: 2.5rem 0 1rem;
      }

      h3 {
        font-size: 1.1rem;
        margin: 1.75rem 0 0.75rem;
      }

      p {
        margin: 0 0 1.25rem;
      }

      a {
        color: var(--lien);
        text-decoration: underline;
        text-underline-offset: 0.15em;
      }

      a:hover,
      a:focus {
        text-decoration-thickness: 2px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 0 0 1.5rem;
        font-size: 0.98rem;
      }

      th,
      td {
        text-align: left;
        padding: 0.55rem 0.65rem;
        border-bottom: 1px solid var(--bordure);
      }

      th {
        font-weight: 600;
        background: var(--encadre);
      }

      .encadre {
        background: var(--encadre);
        border-left: 3px solid var(--lien);
        padding: 1rem 1.25rem;
        margin: 0 0 1.5rem;
      }

      .encadre p:last-child {
        margin-bottom: 0;
      }

      .maj {
        color: var(--discret);
        font-size: 0.9rem;
        margin: -0.75rem 0 2rem;
      }

      ul.contenu {
        margin: 0 0 1.25rem;
        padding-left: 1.25rem;
      }

      ul.contenu li {
        margin-bottom: 0.4rem;
      }

      .sources {
        font-size: 0.9rem;
        color: var(--discret);
      }

      footer p {
        margin: 1.25rem 0 0;
      }
    </style>
  </head>

  <body>
    <header>
      <nav aria-label="Navigation principale">
        <ul>
          {pages.map((page) => (
            <li><a href={page.href}>{page.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <nav aria-label="Navigation de pied de page">
        <ul>
          {[...pages, ...legalPages].map((page) => (
            <li><a href={page.href}>{page.label}</a></li>
          ))}
        </ul>
      </nav>
      <p>
        Informations générales sur le photovoltaïque en France, mises à jour après
        l'arrêté du 1<sup>er</sup> juin 2026. Ce site ne constitue pas un conseil
        financier.
      </p>
    </footer>
  </body>
</html>
